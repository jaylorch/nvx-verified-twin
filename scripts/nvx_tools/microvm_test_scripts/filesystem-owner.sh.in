set -eu
fail() {
    code="$1"
    echo "NVX-FILESYSTEM-OWNER-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}

share=/mnt/share
owner=@OWNER@
foreign=@FOREIGN@
other_group=@OTHER_GROUP@

case @ROOT_RESULT@ in
    owned)
        # Guest root is squashed to the owner of the export root.
        [ "$(stat -c %u:%g "$share")" = "$owner" ] || fail 100
        printf 'root\n' >"$share/root-file" || fail 101
        mkdir "$share/root-directory" || fail 102
        printf 'nested\n' >"$share/root-directory/nested" || fail 103
        [ "$(stat -c %u:%g "$share/root-file")" = "$owner" ] || fail 104
        [ "$(stat -c %u:%g "$share/root-directory/nested")" = "$owner" ] || fail 105

        # The squashed identity has neither host privilege nor OpenVMM's
        # other supplementary groups.
        if chown 0:0 "$share/root-file" 2>/dev/null; then
            fail 106
        fi
        if chown "$foreign" "$share/root-file" 2>/dev/null; then
            fail 107
        fi
        if mknod "$share/device" c 1 3 2>/dev/null; then
            fail 108
        fi
        if [ "$other_group" != none ] &&
            chgrp "$other_group" "$share/root-file" 2>/dev/null; then
            fail 119
        fi
        chmod 4755 "$share/root-file" || fail 109
        ;;
    denied)
        # OpenVMM cannot drop its other supplementary groups, so even guest
        # root fails closed.
        if error=$(stat -c %u:%g "$share" 2>&1); then
            fail 120
        fi
        case "$error" in
            *'Operation not permitted'*) ;;
            *) fail 121 ;;
        esac
        if (printf 'root\n' >"$share/root-file") 2>/dev/null; then
            fail 122
        fi
        if mkdir "$share/root-directory" 2>/dev/null; then
            fail 123
        fi
        ;;
    *) fail 124 ;;
esac

as_foreign() {
    setpriv --reuid="${foreign%:*}" --regid="${foreign#*:}" --clear-groups \
        -- sh -c "$1"
}

# Any other caller either owns what it creates or fails closed with EPERM.
case @FOREIGN_RESULT@ in
    owned)
        as_foreign "mkdir $share/foreign" || fail 110
        as_foreign "mkdir $share/foreign/nested" || fail 111
        as_foreign "printf 'foreign\n' >$share/foreign/nested/file" || fail 112
        [ "$(stat -c %u:%g "$share/foreign/nested/file")" = "$foreign" ] || fail 113
        # Let the unprivileged host test clean up afterwards.
        as_foreign "chmod 0777 $share/foreign $share/foreign/nested" || fail 114
        ;;
    denied)
        if error=$(as_foreign "mkdir $share/foreign" 2>&1); then
            fail 115
        fi
        case "$error" in
            *'Operation not permitted'*) ;;
            *) fail 116 ;;
        esac
        if as_foreign "cat $share/root-file" >/dev/null 2>&1; then
            fail 117
        fi
        ;;
    *) fail 118 ;;
esac

echo NVX-FILESYSTEM-OWNER-OK
nvx-exit 0
